# Mixology Studio — Environment Variables
# Copy to .env.local for local dev. Set in Railway dashboard for production.

# ─── Required (production) ───────────────────────────────────────────────────
# Postgres connection string. Railway provides this when you add a Postgres plugin.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ─── Required (anywhere) ────────────────────────────────────────────────────
# Public base URL of the deployed site. Used for canonical links, OG tags.
# Local: http://localhost:3000
# Production: https://<your-app>.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional (for v1.1 LLM innovation) ─────────────────────────────────────
# When implementing the "Generate innovative cocktail" feature, set one of:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# ─── Optional observability ─────────────────────────────────────────────────
# Sentry DSN for error tracking in production (v1.1+)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Local-only ─────────────────────────────────────────────────────────────
# In dev, leave DATABASE_URL empty — the app reads from data/*.json.
# Run `npx prisma generate` if you switch to Prisma in v1.1.
